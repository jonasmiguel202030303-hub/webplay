# WebPlay Brasil — backend. Copie para .env e preencha. NUNCA versione o .env.
NODE_ENV=development
PORT=4000

# URL pública do frontend (usada em links de e-mail, CORS e cookies).
APP_URL=http://localhost:5173
# URL pública do backend (usada como notification_url do Mercado Pago). Em produção costuma ser igual a APP_URL.
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Número de proxies reversos à frente do Node (Hostinger/Nginx = 1). Em desenvolvimento use 0.
TRUST_PROXY=0
# Em produção o Express serve o build do frontend (frontend/dist).
SERVE_FRONTEND=false

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=webplay
DB_PASSWORD=
DB_NAME=webplay
DB_POOL_SIZE=10

# Segredos: gere com `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# 32 bytes em base64 ou 64 caracteres hex: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Rotação: mova a chave antiga para cá e gere uma nova em ENCRYPTION_KEY (use outro ID).
ENCRYPTION_KEY_PREV=
ENCRYPTION_KEY_PREV_ID=k0

COOKIE_SECURE=false
STAFF_SESSION_HOURS=12
VIEWER_SESSION_DAYS=7

# Uploads
STORAGE_DIR=storage
UPLOAD_MAX_BYTES=2097152

# E-mail (SMTP). Sem SMTP_HOST, os e-mails são gravados em email_outbox e no log (apenas desenvolvimento).
MAIL_FROM="WebPlay Brasil <no-reply@webplaybrasil.online>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Fontes de conteúdo (Xtream Codes). Em produção HTTP é bloqueado por padrão.
ALLOW_HTTP_SOURCES=true
# Hosts privados/loopback liberados explicitamente (SOMENTE desenvolvimento, ex.: mock local).
SSRF_ALLOWED_HOSTS=
# Se preenchido, somente estes domínios podem ser cadastrados como fonte.
SOURCE_HOST_ALLOWLIST=
SOURCE_TIMEOUT_MS=10000
SOURCE_MAX_BYTES=26214400
MAX_SERVERS_PER_TENANT=5

# Prevenção de abuso do teste grátis
TRIAL_MAX_PER_IP=2
TRIAL_IP_WINDOW_DAYS=30

# Mercado Pago (credenciais ficam no painel master, criptografadas no banco)
MP_API_BASE=https://api.mercadopago.com

# Somente desenvolvimento: senha do usuário master criado por `npm run seed:dev`
SEED_PASSWORD=
