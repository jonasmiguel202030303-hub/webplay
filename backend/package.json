{
  "name": "webplay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env database/migrate.js",
    "seed:dev": "node --env-file-if-exists=.env database/seeds/dev.js",
    "create-master": "node --env-file-if-exists=.env scripts/create-master.js",
    "mock-source": "node tools/mock-xtream.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "loadtest": "node --env-file-if-exists=.env tests/load/loadtest.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "undici": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
